    <string name="title_fixed_perf">Enable Fixed Performance</string>
    <string name="desc_fixed_perf">Lock device performance to a fixed state to maintain consistent frame rates.</string>
    <string name="title_optimize">Optimize System Performance</string>
    <string name="desc_optimize">Clear background processes and allocate resources to active applications.</string>
    <string name="title_refresh">Adjust Refresh Rate</string>
    <string name="desc_refresh">Modify the screen refresh rate to balance smooth visuals and battery life.</string>
    <string name="title_network">Improve Network Performance</string>
    <string name="desc_network">Prioritize network traffic and reduce ping for a lag-free experience.</string>
    <string name="title_touch">Improve Touch Latency and Response</string>
    <string name="desc_touch">Increase touch sampling rate for faster and more precise screen interactions.</string>
    <string name="title_anim">Speed Up UI Animations</string>
    <string name="desc_anim">Reduces system animation scales to 0.5x, making app launches and navigation feel twice as fast.</string>
    <string name="title_blurs">Disable Window Blurs</string>
    <string name="desc_blurs">Disables real-time background blurring behind notifications and dialogs to reduce GPU load.</string>
    <string name="title_focus">Gaming Focus Mode</string>
    <string name="desc_focus">Blocks heads-up notification banners from dropping down over the screen while playing.</string>
    <string name="title_devopts">Hide Developer Options</string>
    <string name="desc_devopts">Instantly turns off Developer Options to allow banking apps and anti-cheat games to run properly.</string>
    <string name="title_resolution">Change Screen Resolution</string>
    <string name="desc_resolution">Adjust the display resolution to improve gaming performance and battery life.</string>
    <string name="title_dns">Custom DNS</string>
    <string name="desc_dns">Set a private DNS provider for reliable ad blocking, tracker protection, and lower latency.</string>
    <string name="title_crosshair">Enable Crosshair Overlay</string>
    <string name="desc_crosshair">Displays a customizable crosshair in the center of the screen for FPS games.</string>
    <string name="title_monitor">Real-time Hardware Monitor</string>
    <string name="desc_monitor">Displays a floating, draggable overlay with live RAM, CPU freq, storage, battery, refresh rate and network speed stats like MSI Afterburner.</string>
    <string name="title_autoclick">Auto Click &amp; Auto Swipe</string>
    <string name="desc_autoclick">A floating button that automatically taps or swipes the screen at set intervals. Ideal for games that restrict AFK play.</string>
    <string name="title_gamemode">Native Game Mode API</string>
    <string name="desc_gamemode">For Android 12+. Drops system limits and heavily prioritizes CPU/GPU for the selected game.</string>
    <string name="title_thermal">Disable Thermal Throttling</string>
    <string name="desc_thermal">Tricks the device into thinking it is cool to prevent performance drops. WARNING: Device will get hot.</string>
    <string name="title_fstrim">Storage Optimizer (Fstrim)</string>
    <string name="desc_fstrim">Forces the storage controller to wipe deleted data blocks, instantly restoring read/write speeds.</string>
    <string name="title_ram">RAM Booster</string>
    <string name="desc_ram">See which apps are using the most memory right now and stop the heavy ones in one tap.</string>
    <string name="title_cache">Clear App Caches</string>
    <string name="desc_cache">Removes temporary cache files from every app to free up storage. Your accounts and saved data stay safe.</string>
    <string name="title_freeze">Freeze Bloatware</string>
    <string name="desc_freeze">Freeze apps you don\'t use so they stop using RAM and background CPU. Fully reversible with one tap.</string>
