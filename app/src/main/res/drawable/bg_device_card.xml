<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient outline: gold (premium) -> green (free) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/outlineGold"
                android:endColor="@color/outlineGreen" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Rich three-stop fill -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/gradientCenter"
                android:endColor="@color/gradientEnd"
                android:startColor="@color/gradientStart" />
            <corners android:radius="22.5dp" />
        </shape>
    </item>
    <!-- Soft glossy sheen from the top-left -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#33FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="22.5dp" />
        </shape>
    </item>
</layer-list>
